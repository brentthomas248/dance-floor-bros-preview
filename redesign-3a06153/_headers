/img/*
  Cache-Control: public, max-age=31536000

# Photographs keep their file names when the editor replaces them, so browsers must
# ask before reusing a copy; a replacement or a rollback shows on the next visit.
/photos/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000
